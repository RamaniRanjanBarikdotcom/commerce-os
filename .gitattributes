# Normalise text files to LF in the repository and in the working tree,
# regardless of the local core.autocrlf setting.
* text=auto eol=lf

# Binary files: never convert line endings or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.zip binary
*.gz binary
