# Copy to .env to override local defaults. Every value here is a fake,
# development-only placeholder; never put real secrets in this file.

# PostgreSQL 17 with pgvector
POSTGRES_USER=commerce
POSTGRES_PASSWORD=commerce_dev_only
POSTGRES_DB=commerce
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Temporal dev server (gRPC and web UI)
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233

# SeaweedFS S3 gateway (local S3-compatible server)
S3_PORT=8333

# Keycloak (development identity provider)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_only
KEYCLOAK_PORT=8080

# Mailpit (mail catcher: SMTP and web UI)
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
